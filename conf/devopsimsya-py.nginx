server {
    listen 6969;
    server_name _;

    location / {
        # проксирует трафик на внутренний сокет Gunicorn, он у нас как раз на 8888
        proxy_pass http://127.0.0.1:8888;
        # пробрасывает исходные данные клиента (настоящий IP, хост, протокол) в FastAPI для корректного логирования и обработки запросов
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}