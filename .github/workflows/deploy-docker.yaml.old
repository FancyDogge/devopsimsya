name: Docker - Build, Push & Deploy

on:
  push:
    branches: [ "main" ]
    paths:
      - "py_app/**"
      - "js_app/**"
      - "compose.yaml"
      - "conf/**"

  workflow_dispatch:

jobs:
  build-and-push:
    runs-on: ubuntu-latest
    steps:
      - name: Checkout code
        uses: actions/checkout@v7

      - name: Set up Docker Buildx
        uses: docker/setup-buildx-action@v4.3.0

      - name: Log in to Docker Hub
        uses: docker/login-action@v4.6.0
        with:
          username: ${{ secrets.DOCKERHUB_USERNAME }}
          password: ${{ secrets.DOCKERHUB_TOKEN }}

      - name: Build & Push Python App
        uses: docker/build-push-action@v7.3.0
        with:
          context: ./py_app
          push: true
          tags: |
            ${{ secrets.DOCKERHUB_USERNAME }}/devopsimsya-py:latest
            ${{ secrets.DOCKERHUB_USERNAME }}/devopsimsya-py:${{ github.sha }}

      - name: Build & Push Node.js App
        uses: docker/build-push-action@v7.3.0
        with:
          context: ./js_app
          push: true
          tags: |
            ${{ secrets.DOCKERHUB_USERNAME }}/devopsimsya-js:latest
            ${{ secrets.DOCKERHUB_USERNAME }}/devopsimsya-js:${{ github.sha }}

  docker-deploy:
    needs: build-and-push
    runs-on: ubuntu-latest
    steps:
      - name: Checkout repository
        uses: actions/checkout@v7

      - name: Copy Compose and Nginx configs to VPS
        uses: appleboy/scp-action@v1
        with:
          host: ${{ secrets.VPS_IP }}
          username: ${{ vars.VPS_USER }}
          key: ${{ secrets.SSH_PRIVATE_KEY }}
          source: "compose.yaml,conf/nginx-gateway.conf"
          target: "/opt/devopsimsya"

      - name: Deploy containers on VPS
        uses: appleboy/ssh-action@v1.2.5
        with:
          host: ${{ secrets.VPS_IP }}
          username: ${{ vars.VPS_USER }}
          key: ${{ secrets.SSH_PRIVATE_KEY }}
          # set -e чтобы пайплайн строго проверял исполнение каждой команды и краснел
          script: |
            set -e
            cd /opt/devopsimsya
            docker compose pull
            docker compose up -d --remove-orphans
            docker image prune -f